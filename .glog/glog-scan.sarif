                    "rendered": {
                      "text": "strcpy(info.container_name, container_id.c_str()",
                      "markdown": "`strcpy(info.container_name, container_id.c_str()`"
                    }
                  },
                  "sourceLanguage": "cpp"
                }
              }
            }
          ],
          "fixes": [
