                  "charLength": 127,
                  "snippet": {
                    "text": "memcpy(\n            &cper_data[data_idx],\n            reinterpret_cast<const char*>(header),\n            header->record_length)",
                    "rendered": {
                      "text": "memcpy(\n            &cper_data[data_idx],\n            reinterpret_cast<const char*>(header),\n            header->record_length)",
                      "markdown": "`memcpy(\n            &cper_data[data_idx],\n            reinterpret_cast<const char*>(header),\n            header->record_length)`"
                    }
                  },
                  "sourceLanguage": "cpp"
                }
              }
            }
          ],
