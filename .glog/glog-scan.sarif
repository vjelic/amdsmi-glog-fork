                  "snippet": {
                    "text": "strcpy(name, \"CP_CE\")",
                    "rendered": {
                      "text": "strcpy(name, \"CP_CE\")",
                      "markdown": "`strcpy(name, \"CP_CE\")`"
                    }
                  },
                  "sourceLanguage": "cpp"
                }
              }
            }
          ],
          "fixes": [
