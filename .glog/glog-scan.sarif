                    "rendered": {
                      "text": "strcpy(name, \"CP_MEC_JT1\")",
                      "markdown": "`strcpy(name, \"CP_MEC_JT1\")`"
                    }
                  },
                  "sourceLanguage": "cpp"
                }
              }
            }
          ],
          "fixes": [
