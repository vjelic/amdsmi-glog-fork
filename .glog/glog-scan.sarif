                        "charLength": 25
                      },
                      "insertedContent": {
                        "text": "strlcpy(name,  \"ID_TA_RAS\", <size of name>)"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "properties": {
            "DevSkimSeverity": "Important",
            "DevSkimConfidence": "High",
            "tags": [
              "API.DangerousAPI.BannedFunction"
