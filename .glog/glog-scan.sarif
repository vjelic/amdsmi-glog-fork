                  "charLength": 21,
                  "snippet": {
                    "text": "strcpy(name, \"SDMA4\")",
                    "rendered": {
                      "text": "strcpy(name, \"SDMA4\")",
                      "markdown": "`strcpy(name, \"SDMA4\")`"
                    }
                  },
                  "sourceLanguage": "cpp"
                }
              }
            }
          ],
          "fixes": [
            {
              "description": {
                "text": "strcpy is frequently dangerous, as it will cause a buffer overflow if the source is larger than the destination."
              },
              "artifactChanges": [
